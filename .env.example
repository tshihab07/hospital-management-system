# ---------------------------------------------------------------------------
# IHMS — Environment configuration template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Settings module to load: config.settings.dev | .test | .staging | .prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Secret key used for cryptographic signing. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated hostnames allowed to serve the app.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme://host origins trusted for CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- IHMS domain -----------------------------------------------------------
# UHID prefix, e.g. DHK-2026-000123
UHID_PREFIX=DHK
# IPD admission number prefix, e.g. IP-2026-00001
IP_PREFIX=IP
# Session lifetime in seconds (default 1 hour).
SESSION_COOKIE_AGE=3600

# --- Cache / async (leave Redis blank for in-memory cache + eager Celery) --
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True

# --- Database (Supabase PostgreSQL) ---------------------------------------
USE_REMOTE_DB=True
# Prefer the pooled connection when True (pgbouncer transaction mode).
USE_POOLER=True
# Session-pooler URL (preferred; direct host usually does not resolve).
DATABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection URL (fallback).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Local database URL used when USE_REMOTE_DB=False.
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/ihms
DB_SSLMODE=require
# Connection max age seconds (keep 0 with the transaction pooler).
DB_CONN_MAX_AGE=0

# --- Supabase Storage (S3-compatible) -------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_REGION_NAME=ap-southeast-1
SUPABASE_BUCKET_NAME=hospital-management

# --- Supabase Auth (JWT) ---------------------------------------------------
JWT_SECRET=
JWT_CURRENT_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Email (console backend in dev; configure SMTP for production) ---------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IHMS <no-reply@ihms.local>

# --- Billing / accounting ------------------------------------------------
BILL_PREFIX=BILL
MONEY_RECEIPT_PREFIX=MR
ADVANCE_PREFIX=ADV
REFUND_PREFIX=REF
CREDIT_NOTE_PREFIX=CN
PACKAGE_PREFIX=PKG
# Default VAT rate (%) applied to new bills.
BILL_DEFAULT_VAT_RATE=0
# Discount % above which manager approval is required.
BILL_DISCOUNT_APPROVAL_PCT=10
# Enable the (sandbox) online payment gateway integration.
PAYMENT_GATEWAY_ENABLED=False
JOURNAL_PREFIX=JE
# 1-12; month the fiscal year starts (Bangladesh: July = 7).
ACCOUNTING_FISCAL_YEAR_START_MONTH=7
ACCOUNTING_DEFAULT_VAT_RATE=15

# --- Laboratory / OT / pharmacy prefixes ----------------------------------
LAB_SAMPLE_PREFIX=SMP
LAB_REPORT_PREFIX=LR
OT_PREFIX=OT
OT_DAY_START=08:00
OT_DAY_END=20:00
PHARMACY_PR_PREFIX=PR
PHARMACY_PO_PREFIX=PO
PHARMACY_GRN_PREFIX=GRN
PHARMACY_EXPIRY_ALERT_DAYS=30
ER_PREFIX=ER

# --- Error tracking (optional; leave blank to disable) ---------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Super Admin (used by `python manage.py seed_superadmin`) --------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
